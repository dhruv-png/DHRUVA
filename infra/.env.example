# Copy to infra/.env for local development. NEVER commit the real file (ADR-020).
# Local-only credentials; production secrets come from the environment or KMS.

POSTGRES_USER=dhruva
POSTGRES_PASSWORD=dhruva_local_only
POSTGRES_DB=dhruva
POSTGRES_PORT=5432

REDIS_PORT=6379

# S02 Core Runtime (ADR-031, ADR-035). All optional; safe defaults apply.
DHRUVA_APP__ENVIRONMENT=local
DHRUVA_APP__DEBUG=false
DHRUVA_APP__HOST=127.0.0.1
DHRUVA_APP__PORT=8000

DHRUVA_LOG__LEVEL=INFO
# json in staging/production, console locally. Leave unset to derive it.
# DHRUVA_LOG__FORMAT=console

DHRUVA_DB__HOST=localhost
DHRUVA_DB__PORT=5432
DHRUVA_DB__NAME=dhruva
DHRUVA_DB__USER=dhruva
DHRUVA_DB__PASSWORD=dhruva_local_only

DHRUVA_REDIS__HOST=localhost
DHRUVA_REDIS__PORT=6379

# S06 Identity, Secrets Vault & Audit (ADR-070, ADR-020). The master key of the
# credential vault: base64-encoded 32 bytes of key material, NOT a passphrase.
# Generate one with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# The default compiled into the code is this placeholder, which is refused both
# by the deployed-environment check and by the adapter itself, so nothing is ever
# encrypted under a key published in this repository.
DHRUVA_CRYPTO__MASTER_KEY=change-me-local_only

# The token signing key (ADR-072). Symmetric HS256 material -- raw bytes, not
# base64, and at least 32 of them, which the issuer refuses to start without.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Deliberately a different key from the vault master key above: the two protect
# different things and rotate on different schedules. Rotating this one
# invalidates every outstanding access token and nothing else; rotating the
# master key means re-wrapping every stored credential.
DHRUVA_AUTH__SIGNING_KEY=change-me-local_only

# Access-token lifetime in seconds. Plan section 15.1 fixes it at fifteen
# minutes, which is what bounds the damage of a token that cannot be revoked.
# Shortening it during an incident is reasonable; lengthening it is a decision.
DHRUVA_AUTH__ACCESS_TOKEN_SECONDS=900
# Refresh-token lifetime in days. Long enough that nobody stores a password in a
# script to avoid re-authenticating, which is the failure ADR-072 names.
DHRUVA_AUTH__REFRESH_TOKEN_DAYS=30

# Tracing is a no-op unless enabled AND an endpoint is set (ADR-040).
DHRUVA_OTEL__ENABLED=false
# DHRUVA_OTEL__ENDPOINT=http://collector:4318
