# Backend image.
#
# Multi-stage: dependencies resolve in a builder layer that is cached
# independently of source changes, so a code edit rebuilds in seconds.
# Runs as a non-root user (plan section 15.1).

FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependency layer: invalidated only by a manifest change.
COPY backend/pyproject.toml backend/uv.lock* /app/backend/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --project /app/backend --no-install-project --no-dev

# Source layer.
COPY backend /app/backend
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --project /app/backend --no-dev


FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/backend/.venv/bin:$PATH" \
    TZ=UTC

RUN groupadd --system --gid 1001 dhruva \
 && useradd --system --uid 1001 --gid dhruva --create-home dhruva

WORKDIR /app
COPY --from=builder --chown=dhruva:dhruva /app /app

USER dhruva

# S01 has no long-running service to expose. The image's contract at this stage
# is that the package installs and imports cleanly; CI asserts exactly that.
# The api/ingest/worker/scheduler entrypoints arrive with S02.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD ["python", "-c", "import dhruva; print(dhruva.__version__)"]

CMD ["python", "-c", "import dhruva; print(f'dhruva {dhruva.__version__} - no service entrypoint until S02')"]
